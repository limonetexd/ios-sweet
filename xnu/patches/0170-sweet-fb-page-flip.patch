+/*
+ * 0170: the active lines of the DSI timing engine scanning the panel, for the 0245 flush guard.
+ * Reads only, as Dana 0145 lines 91-111 (INTF_1 then INTF_2, inside the MDP mapping). Dana 0145
+ * sets FRAME_LINE_COUNT_EN itself when it is off; this does not write it: off means no guard.
+ */
+void
+AppleCLCD::flipProbeLines(void)
+{
+	const uint64_t offs[2] = { SWEET_INTF1_PA - SWEET_MDP_PA, SWEET_INTF2_PA - SWEET_MDP_PA };
+	for (unsigned i = 0; i < 2 && fFlipIntf == NULL; i++) {
+		volatile uint32_t *r = fMdp + offs[i] / 4;
+		const uint32_t en = r[INTF_TIMING_ENGINE_EN / 4], hctl = r[INTF_HSYNC_CTL / 4];
+		const uint32_t period = r[INTF_VSYNC_PERIOD_F0 / 4], vstart = r[INTF_DISPLAY_V_START_F0 / 4];
+		const uint32_t vend = r[INTF_DISPLAY_V_END_F0 / 4], lce = r[INTF_FRAME_LINE_COUNT_EN / 4];
+		const uint32_t hp = hctl >> 16;                         /* Dana 0145 line 98 */
+		if (!(en & 1) || hp == 0) {
+			continue;
+		}
+		const uint32_t total = period / hp, first = vstart / hp, last = (vend + 1) / hp;   /* Dana 0145 line 102 */
+		if (last <= first || last > total || last - first != fHeight) {                     /* Dana 0145 line 103 */
+			IOLog("SWEET FLIP: guard: INTF_%u lines total=%u active=%u-%u do not match %u rows\n",
+			    i + 1, total, first, last, fHeight);
+			continue;
+		}
+		if ((lce & 3) != 3) {
+			IOLog("SWEET FLIP: guard: INTF_%u line counter not enabled (%#x)\n", i + 1, lce);
+			continue;
+		}
+		fFlipIntf = r;
+		fFlipTotal = total;
+		fFlipFirst = first;
+		fFlipLast = last;
+		IOLog("SWEET FLIP: guard: INTF_%u lines total=%u active=%u-%u\n", i + 1, total, first, last);
+	}
+	if (fFlipIntf == NULL) {
+		IOLog("SWEET FLIP: guard off (no usable timing engine); flips stay allowed\n");
+	}
+}
+
+/* 0170 review: a failed flipSetup leaves no MDP mapping behind */
+void
+AppleCLCD::flipUnmapMdp(void)
+{
+	if (fMdp != NULL) {
+		volatile uint32_t *mdp = fMdp;
+		fMdp = NULL;
+		fFlipIntf = NULL;
+		ml_io_unmap((vm_offset_t)mdp, (vm_size_t)SWEET_MDP_LEN);
+	}
+}
+
+/*
+ * 0170, Dana 0181 flipSetup: runs on the present thread when flip is first asked for. Checks that
+ * ABL's pipeline is VIG0 -> CTL0 -> INTF scanning fPhys and that a second buffer fits in the rest of
+ * cont_splash_region before any MDP write. Any failure: single buffer, nothing written.
+ * The region (0x9c000000 + 0x1700000) is below XNU's managed RAM, which starts at 0xb0000000
+ * (tools/mkadt.py:13), so the back buffer is memory the kernel never allocates.
+ */
+bool
+AppleCLCD::flipSetup(void)
+{
+	if (fFlipReady) {
+		return true;
+	}
+	if (fMdp == NULL) {
+		fMdp = (volatile uint32_t *)ml_io_map(SWEET_MDP_PA, SWEET_MDP_LEN);
+	}
+	if (fMdp == NULL) {
+		IOLog("SWEET FLIP: off (MDP map failed)\n");
+		return false;
+	}
+	const uint32_t addr = fMdp[SWEET_VIG0_SRC0_ADDR / 4], size = fMdp[SWEET_VIG0_SRC_SIZE / 4];
+	const uint32_t stride = fMdp[SWEET_VIG0_YSTRIDE0 / 4] & 0xffff, layer = fMdp[SWEET_CTL0_LAYER0 / 4];
+	const uint32_t intf = fMdp[SWEET_CTL0_INTF_ACTIVE / 4], flush = fMdp[SWEET_CTL0_FLUSH / 4];
+	if (addr != (uint32_t)fPhys || size != ((fHeight << 16) | fWidth) || stride != fRowBytes ||
+	    (layer & 7) == 0 || intf == 0 || flush != 0 || fPhys >> 32) {
+		IOLog("SWEET FLIP: off (pipeline differs: vig0 addr %#x size %#x stride %#x, ctl0 layer %#x intf %#x flush %#x)\n",
+		    addr, size, stride, layer, intf, flush);
+		flipUnmapMdp();
+		return false;
+	}
+	/* 0170: stricter than Dana: the region bound below only holds if the panel buffer starts it */
+	if (fPhys != SWEET_FB_REGION_PA) {
+		IOLog("SWEET FLIP: off (framebuffer %#llx is not at cont_splash_region %#llx)\n", fPhys, SWEET_FB_REGION_PA);
+		flipUnmapMdp();
+		return false;
+	}
+	const uint64_t bytes = ((uint64_t)fRowBytes * fHeight + 0xffff) & ~0xffffULL;
+	const uint64_t back = fPhys + bytes;
+	if (back + bytes > fPhys + SWEET_FB_REGION_LEN || (back + bytes) >> 32) {
+		IOLog("SWEET FLIP: off (no room for a back buffer, %#llx bytes)\n", bytes);
+		flipUnmapMdp();
+		return false;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(back, bytes, kIODirectionInOut);
+	fBufMap = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+	OSSafeReleaseNULL(md);
+	if (fBufMap == NULL || fBufMap->getVirtualAddress() == 0) {
+		OSSafeReleaseNULL(fBufMap);
+		IOLog("SWEET FLIP: off (back buffer map failed)\n");
+		flipUnmapMdp();
+		return false;
+	}
+	fBufPhys[0] = fPhys;
+	fBufVA[0] = fPixels;
+	fBufPhys[1] = back;
+	fBufVA[1] = (uintptr_t)fBufMap->getVirtualAddress();
+	memcpy((void *)fBufVA[1], (const void *)fBufVA[0], (size_t)fRowBytes * fHeight);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	flipProbeLines();
+	fScan = 0;
+	fFlipPending = false;
+	fFlipReady = true;
+	IOLog("SWEET FLIP: on: buffers %#llx %#llx (%#llx bytes), vig0 -> ctl0 flush %#x\n",
+	    fBufPhys[0], fBufPhys[1], bytes, __atomic_load_n(&sweet_fb_flip_mask, __ATOMIC_RELAXED));
+	return true;
+}
+
+/* Dana 0181 flipWait (mask: 0244): the buffer about to be written must no longer be on screen. */
+bool
+AppleCLCD::flipWait(void)
+{
+	if (!fFlipPending) {
+		return true;
+	}
+	const uint64_t began = mach_absolute_time();
+	uint64_t ns = 0;
+	for (;;) {
+		if ((fMdp[SWEET_CTL0_FLUSH / 4] & fFlipMaskUsed) == 0) {
+			break;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		if (ns > (uint64_t)SWEET_FLIP_TIMEOUT_US * 1000) {
+			__atomic_add_fetch(&fStatsFlipTimeouts, 1, __ATOMIC_RELAXED);
+			flipAbandon("flush not latched");
+			return false;
+		}
+		IODelay(100);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+	const uint64_t us = ns / NSEC_PER_USEC;
+	fFlipPending = false;
+	__atomic_add_fetch(&fStatsFlipWaitUs, us, __ATOMIC_RELAXED);
+	if (us > fStatsFlipWaitMaxUs) {
+		fStatsFlipWaitMaxUs = us;
+	}
+	return true;
+}
+
+/* Dana 0181 flipTo, flush mask from 0244, line guard from 0245. fPixels is not repointed (0170). */
+void
+AppleCLCD::flipTo(unsigned idx)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");       /* write-combined frame reaches memory first */
+	if (fFlipIntf != NULL && fFlipLast > fFlipFirst) {
+		/* Dana 0245 lines 52-67: keep the flush out of the frame end and the blanking gap */
+		const uint32_t guard = __atomic_load_n(&sweet_fb_flip_guard, __ATOMIC_RELAXED);
+		const uint32_t from = guard < fFlipLast - fFlipFirst ? fFlipLast - guard : fFlipFirst;
+		uint32_t line = fFlipIntf[INTF_LINE_COUNT / 4];
+		if (guard != 0 && (line >= from || line < fFlipFirst + 8)) {
+			const uint64_t began = mach_absolute_time();
+			uint64_t ns = 0;
+			while ((line >= from || line < fFlipFirst + 8) && ns < 1000000) {
+				IODelay(5);
+				line = fFlipIntf[INTF_LINE_COUNT / 4];
+				absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+			}
+			__atomic_add_fetch(&fStatsGuardWaits, 1, __ATOMIC_RELAXED);
+		}
+	}
+	fMdp[SWEET_VIG0_SRC0_ADDR / 4] = (uint32_t)fBufPhys[idx];      /* Dana 0181 line 144 */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* Dana 0244 lines 107-108, restricted (0170 review): only bits 0, 6, 17 ever reach CTL0_FLUSH;
+	 * VIG0 (bit 0) or CTL (bit 17) missing -> the default 0x20041 */
+	uint32_t mask = __atomic_load_n(&sweet_fb_flip_mask, __ATOMIC_RELAXED) & SWEET_FLIP_FLUSH_BITS;
+	if ((mask & (1u << 0)) == 0 || (mask & (1u << 17)) == 0) {
+		mask = SWEET_FLIP_FLUSH_BITS;
+	}
+	fFlipMaskUsed = mask;
+	fMdp[SWEET_CTL0_FLUSH / 4] = fFlipMaskUsed;                     /* Dana 0244 line 109 */
+	fScan = idx;
+	fFlipPending = true;
+	__atomic_add_fetch(&fStatsFlips, 1, __ATOMIC_RELAXED);
+}
+
+/* Dana 0181 flipAbandon: back to buffer 0 and the beam-raced copy; 0170: for the rest of the boot. */
+void
+AppleCLCD::flipAbandon(const char *why)
+{
+	IOLog("SWEET FLIP: off (%s: flush %#x addr %#x); single buffer from now on\n",
+	    why, fMdp[SWEET_CTL0_FLUSH / 4], fMdp[SWEET_VIG0_SRC0_ADDR / 4]);
+	fFlip = false;
+	fFlipPending = false;
+	fFlipDead = true;
+	fFlipMode = 0;
+	__atomic_store_n(&sweet_fb_flip_req, 0, __ATOMIC_RELAXED);
+	/*
+	 * 0170 review: fScan is the requested buffer, not necessarily the latched one (a flipTo(0) that
+	 * timed out has fScan 0). Once ready, always point VIG0 back at buffer 0 and flush.
+	 */
+	if (fFlipReady) {
+		if (fScan != 0) {
+			memcpy((void *)fBufVA[0], (const void *)fBufVA[fScan], (size_t)fRowBytes * fHeight);
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		fMdp[SWEET_VIG0_SRC0_ADDR / 4] = (uint32_t)fBufPhys[0];         /* Dana 0181 line 164 */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		fMdp[SWEET_CTL0_FLUSH / 4] = SWEET_FLIP_FLUSH_BITS;             /* Dana 0181 line 166 */
+	}
+	fScan = 0;
+}
+
+/* Dana 0244 flipSampleStatus (underrun bits only): read and clear, only once the checks passed. */
+void
+AppleCLCD::flipSampleStatus(void)
+{
+	if (!fFlipReady) {
+		return;
+	}
+	const uint32_t bits = SWEET_INTR_INTF1_UNDERRUN | SWEET_INTR_INTF2_UNDERRUN;
+	const uint32_t st = fMdp[SWEET_MDP_INTR_STATUS / 4] & bits;
+	if (st & SWEET_INTR_INTF1_UNDERRUN) {
+		__atomic_add_fetch(&fStatsUnderrun1, 1, __ATOMIC_RELAXED);
+	}
+	if (st & SWEET_INTR_INTF2_UNDERRUN) {
+		__atomic_add_fetch(&fStatsUnderrun2, 1, __ATOMIC_RELAXED);
