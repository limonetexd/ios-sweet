+/*
+ * 0168: one source row (scaleSrcW pixels from srcColumn) into a slot of the line buffer. The
+ * source is GPU-pool memory mapped write-combined (Normal non-cacheable): every load from it is
+ * an uncached load, so it is read once, sequentially, in one memcpy, and blended from cached
+ * memory. Kernel memcpy is fine on Normal-NC memory (unaligned access is permitted on Normal
+ * memory, only Device memory forbids it).
+ */
+static inline void
+sweet_fb_load_row(const SweetCopyJob *job, uint32_t *slot, uint32_t row)
+{
+	memcpy(slot, (const void *)(job->srcRows + (uint64_t)row * job->srcRowBytes + job->srcColumn),
+	    (size_t)job->scaleSrcW * 4);
+}
