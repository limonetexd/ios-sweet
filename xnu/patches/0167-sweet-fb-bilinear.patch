+/*
+ * 0167: pixel-centre mapping of destination index d (of dstN) onto the source (of srcN): the first
+ * source index, returned, and the weight of the next one in *frac (0..255). At the last source
+ * index the weight is 0, so nothing past it is needed.
+ */
+static inline uint32_t
+sweet_fb_centre(uint32_t d, uint32_t srcN, uint32_t dstN, uint32_t *frac)
+{
+	uint64_t f = ((2 * (uint64_t)d + 1) * srcN * 256) / (2 * (uint64_t)dstN);
+	f = f >= 128 ? f - 128 : 0;
+	uint32_t i = (uint32_t)(f >> 8);
+	uint32_t w = (uint32_t)(f & 255);
+	if (i >= srcN - 1) {
+		i = srcN - 1;
+		w = 0;
+	}
+	*frac = w;
+	return i;
+}
+
+/* 0167: (a * (256 - w) + b * w) >> 8 per 8-bit channel, w 0..255; w 0 gives a exactly */
+static inline uint32_t
+sweet_fb_lerp(uint32_t a, uint32_t b, uint32_t w)
+{
+	uint32_t iw = 256 - w;
+	/* each 16-bit lane sums to at most 255 * 256: no carry into the next lane */
+	uint32_t rb = (((a & 0x00FF00FF) * iw + (b & 0x00FF00FF) * w) >> 8) & 0x00FF00FF;
+	uint32_t ag = (((a >> 8) & 0x00FF00FF) * iw + ((b >> 8) & 0x00FF00FF) * w) & 0xFF00FF00;
+	return rb | ag;
+}
