diff --git a/bsd/dev/sweet_reboot_timer.c b/bsd/dev/sweet_reboot_timer.c
new file mode 100644
index 0000000..c4fbe56
--- /dev/null
+++ b/bsd/dev/sweet_reboot_timer.c
@@ -0,0 +1,95 @@
+/*
+ * 0250: sweetgpu_reboot=SECONDS, back to fastboot after a test boot.
+ *
+ * tools/sweet-boot-test.sh and tools/metal-flash-test.sh RAM-boot an image and wait for the phone
+ * to come back to fastboot by itself. Same boot-arg and sequence as sg_reboot_fastboot() on branch
+ * gpu (redwood 0082); same PON spare / IMEM reason / PSCI path as DC28088 sweet_reboot.c (no PS_HOLD).
+ *
+ *   absent or N <= 20  nothing is created or written
+ *   N > 20             one kernel thread, started once the UFS root is up (bsd/dev/sweet_ufs.c),
+ *                      sleeps N s, then
+ *                        1. PM6150 SID 0 PON_SOFT_RB_SPARE 0x088f <- 0x02 << 1 (fastboot reason),
+ *                           through sweet_spmi_write() (bsd/dev/sweet_spmi.c allow-list);
+ *                        2. IMEM restart_reason 0x146aa65c <- 0x77665500 (SM7150 sram@146aa000);
+ *                        3. 12 s for the console ring to reach UFS (0069 flushes every 10 s), then
+ *                           PSCI SYSTEM_RESET.
+ * A failed PON write is logged and steps 2-3 run anyway (the IMEM reason alone may suffice); the
+ * write is issued once, never retried here.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void sweet_reboot_timer_start(void);
+
+#define SRT_PON_SID             0u
+#define SRT_PON_SOFT_RB_SPARE   0x088fu
+#define SRT_PON_FASTBOOT        (0x02u << 1)
+#define SRT_IMEM_RESTART_REASON 0x146aa65cu
+#define SRT_IMEM_FASTBOOT       0x77665500u
+#define SRT_PSCI_SYSTEM_RESET   0x84000009ull
+
+static int srt_seconds;
+static int srt_chan;
+
+static void
+srt_sleep(unsigned seconds)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(seconds, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&srt_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void __attribute__((noreturn))
+srt_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	printf("SWEET REBOOT: back to fastboot in %d s\n", srt_seconds);
+	srt_sleep((unsigned)srt_seconds);
+	/*
+	 * SweetBattery::start() normally initialised SPMI long before (N > 20 s; sweet_charger.c
+	 * waits 30 s the same way). sweet_spmi_init() only maps the arbiter and reads its version,
+	 * and after its first call it returns the cached result, so calling it here is harmless and
+	 * covers a boot where SweetBattery did not start. If it failed, sweet_spmi_write() returns
+	 * ENXIO and that is the rc logged below.
+	 */
+	(void)sweet_spmi_init();
+	int rc = sweet_spmi_write(SRT_PON_SID, SRT_PON_SOFT_RB_SPARE, SRT_PON_FASTBOOT);
+	vm_offset_t imem = ml_io_map(SRT_IMEM_RESTART_REASON & ~0xfffu, 0x1000);
+	if (imem) {
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(imem + (SRT_IMEM_RESTART_REASON & 0xfffu)) = SRT_IMEM_FASTBOOT;
+		__asm__ volatile("dsb osh" ::: "memory");
+	}
+	printf("SWEET REBOOT: rebooting to fastboot (pon rc %d)\n", rc);
+	srt_sleep(12);    /* the console ring is flushed to UFS every 10 s (patch 0069) */
+	register uint64_t x0 __asm__("x0") = SRT_PSCI_SYSTEM_RESET;
+	__asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
+
+void
+sweet_reboot_timer_start(void)
+{
+	static bool started;
+	int seconds = 0;
+	(void)PE_parse_boot_argn("sweetgpu_reboot", &seconds, sizeof(seconds));
+	if (seconds <= 20 || started) {
+		return;
+	}
+	started = true;
+	srt_seconds = seconds;
+	thread_t th;
+	if (kernel_thread_start(srt_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
