 {
-	static const uint16_t allowed[] = {0x1042, 0x1061, 0x1340, 0x1342, 0x1365, 0x1366, 0x1370, 0x1643};
+	/* 0250: + PM6150 PON_SOFT_RB_SPARE 0x088f, the fastboot reason written once right before PSCI
+	 * SYSTEM_RESET at the end of a test boot (sweetgpu_reboot=N, bsd/dev/sweet_reboot_timer.c). */
+	static const uint16_t allowed[] = {0x1042, 0x1061, 0x1340, 0x1342, 0x1365, 0x1366, 0x1370, 0x1643,
+	    0x088f};
 	bool listed = false;
 	for (unsigned i = 0; i < sizeof(allowed) / sizeof(allowed[0]); i++) {
 		listed |= allowed[i] == addr;
