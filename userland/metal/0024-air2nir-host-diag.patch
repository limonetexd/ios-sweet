 static uint8_t
 pattern_byte(unsigned i)
 {
+   if (getenv("AIR_EVAL_ZERO"))   /* host diagnostic: all-zero buffers */
+      return 0;
    return library_wrapper ? library_byte(i) : (i * 7 + 13) & 0xff;
 }
 
