+/*
+ * 0021: one blit, in its place in the replay, under the library lock -commit holds
+ * (recursive, as -runClear: takes it). The GPU ones are queued like a clear and paid by the
+ * commit's one wait; the two between a texture and a buffer's memory are done by the
+ * processor, so everything queued before them is finished first, and the bytes move through
+ * the library's own row-by-row read and write. NO, with the buffer failed, on any refusal:
+ * a copy that did not happen must not read as a result.
+ */
+- (BOOL)runBlitRows:(RedwoodMetalWork *)work
+	    texture:(struct rwa_texture *)texture
+	     memory:(uint8_t *)memory
+	     length:(size_t)length
+	why:(char *)why size:(size_t)size
+{
+	BOOL toBuffer = work->blitOp == RW_BLIT_TEX_BUF;
+	unsigned level = toBuffer ? work->blitSrcLevel : work->blitDstLevel;
+	unsigned slice = toBuffer ? work->blitSrcSlice : work->blitDstSlice;
+	const unsigned *origin = toBuffer ? work->blitSrcOrigin : work->blitDstOrigin;
+	size_t offset = toBuffer ? work->blitDstOffset : work->blitSrcOffset;
+	size_t bpr = work->blitBytesPerRow, bpi = work->blitBytesPerImage;
+	unsigned w = work->blitSize[0], h = work->blitSize[1], d = work->blitSize[2];
+
+	if (w == 0 || h == 0 || d == 0) {
+		return YES;   /* Metal: an empty region copies nothing */
+	}
+	if (bpr == 0 || (d > 1 && bpi < (size_t)h * bpr)) {
+		snprintf(why, size, "a copy of %ux%ux%u texels with %zu bytes per row and %zu per "
+			 "image, which do not hold it", w, h, d, bpr, bpi);
+		return NO;
+	}
+	for (unsigned z = 0; z < d; z++) {
+		size_t at = offset + (size_t)z * bpi;
+		unsigned o[3] = { origin[0], origin[1], origin[2] + z };
+		unsigned full = h;   /* rows read or written straight from the buffer's memory */
+		int rc = 0;
+
+		if (at > length || length - at < (size_t)(h - 1) * bpr) {
+			snprintf(why, size, "image %u of the copy starts at byte %zu of a %zu-byte "
+				 "buffer and its %u rows of %zu bytes do not fit", z, at, length,
+				 h, bpr);
+			return NO;
+		}
+		/* Metal's last row need only hold its texels, not a whole bytesPerRow; the library
+		 * moves bytesPerRow-sized rows' worth of texels, so a short last row goes through a
+		 * row of our own and only what fits in the buffer is moved */
+		if (length - at < (size_t)h * bpr) {
+			full = h - 1;
+		}
+		if (full > 0) {
+			unsigned sz[3] = { w, full, 1 };
+			rc = toBuffer ? mesa.texture_read(texture, level, slice, o, sz, memory + at,
+							  bpr, why, size)
+				      : mesa.texture_write(texture, level, slice, o, sz, memory + at,
+							   bpr, why, size);
+		}
+		if (rc == 0 && full < h) {
+			size_t tail = length - at - (size_t)full * bpr;
+			uint8_t *row = calloc(1, bpr);
+			unsigned ro[3] = { o[0], o[1] + full, o[2] };
+			unsigned sz[3] = { w, 1, 1 };
+
+			if (row == NULL) {
+				snprintf(why, size, "no memory for one row of %zu bytes", bpr);
+				return NO;
+			}
+			if (toBuffer) {
+				rc = mesa.texture_read(texture, level, slice, ro, sz, row, bpr, why,
+						       size);
+				if (rc == 0) {
+					memcpy(memory + at + (size_t)full * bpr, row, tail);
+				}
+			} else {
+				memcpy(row, memory + at + (size_t)full * bpr, tail);
+				rc = mesa.texture_write(texture, level, slice, ro, sz, row, bpr, why,
+							size);
+			}
+			free(row);
+		}
+		if (rc != 0) {
+			return NO;
+		}
+	}
+	return YES;
+}
+
+- (BOOL)runBlit:(RedwoodMetalWork *)work why:(char *)why size:(size_t)size
+{
+	struct rwa_device *device = [[_queue device] mesaDevice];
+	struct rwa_texture *srcTexture = NULL, *dstTexture = NULL;
+	struct rwa_buffer *srcBuffer = NULL, *dstBuffer = NULL;
+	uint8_t *srcMemory = NULL, *dstMemory = NULL;
+	size_t srcLength = 0, dstLength = 0;
+	BOOL ok = YES;
+	int rc = 0;
+
+	why[0] = 0;
+	switch (work->blitOp) {
+	case RW_BLIT_TEX_TEX:
+	case RW_BLIT_TEX_BUF:
+	case RW_BLIT_MIPMAP:
