 }
+
+/*
+ * 0021: the blit encoder's GPU half. Each is one Gallium call on the device's one context,
+ * made under the plug-in's library lock like every other call here, and waited for the way a
+ * clear is: at once, or -- with rwa_set_deferred_wait on -- by the caller's one rwa_finish or
+ * rwa_flush at the end of the command buffer. What a call refuses it refuses by name and
+ * before Gallium is asked, because freedreno programs what it is given.
+ */
+static int
+blit_wait(struct rwa_device *device, const char *what, char *why, size_t why_size)
+{
+   return device->deferred_wait ? 0 : finish_or_say_why(device, true, what, why, why_size);
+}
+
+int
+rwa_texture_copy(struct rwa_device *device, struct rwa_texture *src, unsigned src_level,
+                 unsigned src_layer, const unsigned src_origin[3], const unsigned size[3],
+                 struct rwa_texture *dst, unsigned dst_level, unsigned dst_layer,
+                 const unsigned dst_origin[3], char *why, size_t why_size)
+{
+   struct pipe_box sbox, dbox;
+
+   if (!device || !src || !dst) {
+      say(why, why_size, "a texture copy with no %s",
+          !device ? "device" : !src ? "source texture" : "destination texture");
+      return -1;
+   }
+   if (src->device != device || dst->device != device) {
+      say(why, why_size, "a texture copy between textures of another device");
+      return -1;
+   }
+   /* resource_copy_region copies bytes, not texels it converts: the two formats have to
+    * agree on how many bytes a texel is, and on how many samples one holds */
+   if (util_format_get_blocksize(src->res->format) !=
+          util_format_get_blocksize(dst->res->format) ||
+       util_format_is_depth_or_stencil(src->res->format) !=
+          util_format_is_depth_or_stencil(dst->res->format)) {
+      say(why, why_size, "a copy from %s into %s: a texture copy moves texels as they are, "
+                         "so the two formats must have the same size and kind of texel",
+          src->format_name, dst->format_name);
+      return -1;
+   }
+   if (MAX2(src->res->nr_samples, 1) != MAX2(dst->res->nr_samples, 1)) {
+      say(why, why_size, "a copy between textures of %u and %u samples per texel",
+          MAX2(src->res->nr_samples, 1), MAX2(dst->res->nr_samples, 1));
+      return -1;
+   }
+   if (!texture_box(src, src_level, src_layer, src_origin, size, &sbox, why, why_size))
+      return -1;
+   /* the destination region is the source's size at the destination's origin */
+   unsigned dsize[3] = { size ? size[0] : (unsigned)sbox.width,
+                         size ? size[1] : (unsigned)sbox.height,
+                         size ? size[2] : (src->res->target == PIPE_TEXTURE_3D
+                                              ? (unsigned)sbox.depth : 1) };
+   if (src->res->target == PIPE_TEXTURE_1D || src->res->target == PIPE_TEXTURE_1D_ARRAY)
+      dsize[1] = 1;
+   if (!texture_box(dst, dst_level, dst_layer, dst_origin, dsize, &dbox, why, why_size))
+      return -1;
+
+   struct pipe_context *pipe = device->pipe;
+   pipe->resource_copy_region(pipe, dst->res, dst_level, dbox.x, dbox.y, dbox.z, src->res,
+                              src_level, &sbox);
+   return blit_wait(device, "texture copy", why, why_size);
+}
+
+int
+rwa_buffer_copy(struct rwa_device *device, struct rwa_buffer *src, size_t src_offset,
+                struct rwa_buffer *dst, size_t dst_offset, size_t size, char *why,
+                size_t why_size)
+{
+   if (!device || !src || !dst) {
+      say(why, why_size, "a buffer copy with no %s",
+          !device ? "device" : !src ? "source buffer" : "destination buffer");
+      return -1;
+   }
+   if (src_offset > src->size || size > src->size - src_offset ||
+       dst_offset > dst->size || size > dst->size - dst_offset) {
+      say(why, why_size, "a copy of %zu bytes from offset %zu of a %zu-byte buffer to "
+                         "offset %zu of a %zu-byte one", size, src_offset, src->size,
+          dst_offset, dst->size);
+      return -1;
+   }
+   if (size == 0)
+      return 0;
+   /* Gallium forbids an overlapping copy within one resource, and so does Metal */
+   if (src == dst && src_offset < dst_offset + size && dst_offset < src_offset + size) {
+      say(why, why_size, "a copy of %zu bytes within one buffer from offset %zu to %zu, "
+                         "which overlap", size, src_offset, dst_offset);
+      return -1;
+   }
+
+   struct pipe_box box;
+   u_box_1d((int)src_offset, (int)size, &box);
+   device->pipe->resource_copy_region(device->pipe, dst->res, 0, (unsigned)dst_offset, 0, 0,
+                                      src->res, 0, &box);
+   return blit_wait(device, "buffer copy", why, why_size);
+}
+
+int
+rwa_texture_gen_mipmap(struct rwa_device *device, struct rwa_texture *texture, char *why,
+                       size_t why_size)
+{
+   if (!device || !texture) {
+      say(why, why_size, "a mipmap generation with no %s", !device ? "device" : "texture");
+      return -1;
+   }
+   struct pipe_resource *res = texture->res;
+   if (res->last_level == 0)
+      return 0;   /* one level: Metal's own answer is that there is nothing to make */
+   if (res->nr_samples > 1) {
+      say(why, why_size, "mipmaps for a %s of %u samples per texel, which has one level",
+          texture->format_name, res->nr_samples);
+      return -1;
+   }
+   /* Mesa's own helper, a linear blit level from level, every slice at once. It answers
+    * false only when the screen cannot sample and render the format. */
+   if (!util_gen_mipmap(device->pipe, res, res->format, 0, res->last_level, 0,
+                        res->target == PIPE_TEXTURE_3D ? 0 : texture->layers - 1,
+                        PIPE_TEX_FILTER_LINEAR)) {
+      say(why, why_size, "the GPU driver cannot both sample and render %s, which is what "
+                         "making its mipmaps takes", texture->format_name);
+      return -1;
+   }
+   return blit_wait(device, "mipmap generation", why, why_size);
+}
+
+int
+rwa_buffer_fill(struct rwa_device *device, struct rwa_buffer *buffer, size_t offset,
+                size_t size, unsigned char value, char *why, size_t why_size)
+{
+   if (!device || !buffer) {
+      say(why, why_size, "a buffer fill with no %s", !device ? "device" : "buffer");
+      return -1;
+   }
+   if (offset > buffer->size || size > buffer->size - offset) {
+      say(why, why_size, "a fill of %zu bytes at offset %zu of a %zu-byte buffer", size,
+          offset, buffer->size);
+      return -1;
+   }
+   if (size == 0)
+      return 0;
+
+   struct pipe_context *pipe = device->pipe;
+   if (pipe->clear_buffer) {
+      /* four bytes of the value when the range allows it, which is the width freedreno's
+       * engine fills at; one byte otherwise, which Gallium also defines */
+      uint32_t pattern = value * 0x01010101u;
+      int width = ((offset | size) & 3) == 0 ? 4 : 1;
+      pipe->clear_buffer(pipe, buffer->res, (unsigned)offset, (unsigned)size, &pattern,
+                         width);
+      return blit_wait(device, "buffer fill", why, why_size);
+   }
+   /* No GPU fill (softpipe): through the buffer's own mapping, after everything already
+    * queued has finished, so the bytes land after the work before them and not under it. */
+   int rc = finish_or_say_why(device, false, "work before a buffer fill", why, why_size);
+   if (rc != 0)
+      return rc;
+   memset((uint8_t *)buffer->map + offset, value, size);
+   return 0;
+}
