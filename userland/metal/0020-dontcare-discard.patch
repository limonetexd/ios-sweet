+
+/*
+ * 0020: MTLLoadActionDontCare. freedreno restores an attachment into GMEM for every bin of a
+ * tiled batch whenever the resource is `valid` (freedreno_draw.c: restore_buffers), and
+ * nothing in Gallium's interface says "this pass does not want the old contents" except
+ * invalidate_resource -- which also drops the resolve of the batch still writing it, and
+ * that batch may have readers queued behind it (framebuffer changes do not flush). So this
+ * only clears `valid`, and only when no unflushed batch writes the resource: then the
+ * memory already holds everything ever stored, the next draw skips the restore
+ * (batch->invalidated) and still stores. Never on a software screen.
+ */
+static unsigned discard_done, discard_kept;
+
+static void
+discard_one(struct pipe_resource *prsc)
+{
+#ifdef GALLIUM_FREEDRENO
+   struct fd_resource *rsc = fd_resource(prsc);
+
+   if (rsc->track->write_batch == NULL) {
+      rsc->valid = false;
+      discard_done++;
+   } else {
+      discard_kept++;
+   }
+#else
+   (void)prsc;
+#endif
+}
+
+static void
+discard_pass_contents(struct rwa_device *device, const struct rwa_draw *draw)
+{
+   if (device->software)
+      return;
+   for (unsigned i = 0; i < draw->color_count && i < 32; i++)
+      if ((draw->discard_color_mask & (1u << i)) && draw->color[i] && draw->color[i]->res)
+         discard_one(draw->color[i]->res);
+   if (draw->discard_depth && draw->depth && draw->depth->res)
+      discard_one(draw->depth->res);
+}
+
+/* 0020: attachments discarded, and kept because a batch still writes them, since the last call */
+void
+rwa_discard_stats(unsigned *done, unsigned *kept)
+{
+   *done = discard_done;
+   *kept = discard_kept;
+   discard_done = discard_kept = 0;
 }
 
